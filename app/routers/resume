from __future__ import annotations

from io import BytesIO
from typing import List, Optional

from fastapi import APIRouter
from fastapi.responses import StreamingResponse
from pydantic import BaseModel, Field

# Pure-Python PDF generation (no system deps)
# Add to requirements.txt: reportlab==4.2.5 (or latest compatible)
from reportlab.lib.pagesizes import LETTER
from reportlab.lib.units import inch
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer
from xml.sax.saxutils import escape


router = APIRouter(prefix="/v1/resume", tags=["resume"])


class ResumePdfRequest(BaseModel):
    jd_text: str = Field(..., min_length=1, description="Job description (text or URL-resolved text)")
    template: str = Field(default="Classic ATS")

    first_name: str = Field(..., min_length=1, max_length=60)
    last_name: str = Field(..., min_length=1, max_length=60)
    email: str = ""
    phone: str = ""
    location: str = ""

    target_role: str = Field(..., min_length=1, max_length=80)
    summary: str = ""

    linkedin: str = ""
    github: str = ""
    portfolio: str = ""

    skills: List[str] = Field(default_factory=list)

    experience_text: str = ""
    projects_text: str = ""
    education_text: str = ""
    extras_text: str = ""


def _para_text(text: str) -> str:
    """Escape + preserve newlines."""
    t = (text or "").strip()
    if not t:
        return ""
    lines = [escape(x) for x in t.splitlines()]
    return "<br/>".join(lines)


def _build_pdf(req: ResumePdfRequest) -> bytes:
    buf = BytesIO()

    doc = SimpleDocTemplate(
        buf,
        pagesize=LETTER,
        leftMargin=0.75 * inch,
        rightMargin=0.75 * inch,
        topMargin=0.65 * inch,
        bottomMargin=0.65 * inch,
        title="ResumeMatch Resume",
    )

    styles = getSampleStyleSheet()
    h1 = ParagraphStyle(
        "h1",
        parent=styles["Heading1"],
        fontSize=18,
        leading=20,
        spaceAfter=6,
    )
    h2 = ParagraphStyle(
        "h2",
        parent=styles["Heading2"],
        fontSize=12,
        leading=14,
        spaceBefore=10,
        spaceAfter=4,
    )
    body = ParagraphStyle(
        "body",
        parent=styles["BodyText"],
        fontSize=10.5,
        leading=13,
        spaceAfter=6,
    )
    small = ParagraphStyle(
        "small",
        parent=styles["BodyText"],
        fontSize=9.5,
        leading=12,
        textColor="#444444",
        spaceAfter=6,
    )

    story = []

    full_name = f"{req.first_name.strip()} {req.last_name.strip()}".strip()
    story.append(Paragraph(escape(full_name), h1))

    contact_parts = []
    if req.location.strip():
        contact_parts.append(req.location.strip())
    if req.phone.strip():
        contact_parts.append(req.phone.strip())
    if req.email.strip():
        contact_parts.append(req.email.strip())
    if req.linkedin.strip():
        contact_parts.append(req.linkedin.strip())
    if req.github.strip():
        contact_parts.append(req.github.strip())
    if req.portfolio.strip():
        contact_parts.append(req.portfolio.strip())

    if contact_parts:
        story.append(Paragraph(escape(" • ".join(contact_parts)), small))

    story.append(Paragraph(escape(req.target_role.strip()), small))

    if req.summary.strip():
        story.append(Paragraph("SUMMARY", h2))
        story.append(Paragraph(_para_text(req.summary), body))

    if req.skills:
        story.append(Paragraph("SKILLS", h2))
        # simple comma list is ATS-safe
        skills = ", ".join([s.strip() for s in req.skills if s.strip()])
        story.append(Paragraph(escape(skills), body))

    if req.experience_text.strip():
        story.append(Paragraph("EXPERIENCE", h2))
        story.append(Paragraph(_para_text(req.experience_text), body))

    if req.projects_text.strip():
        story.append(Paragraph("PROJECTS", h2))
        story.append(Paragraph(_para_text(req.projects_text), body))

    if req.education_text.strip():
        story.append(Paragraph("EDUCATION", h2))
        story.append(Paragraph(_para_text(req.education_text), body))

    if req.extras_text.strip():
        story.append(Paragraph("EXTRAS", h2))
        story.append(Paragraph(_para_text(req.extras_text), body))

    # Optional: lightweight "JD Tailoring" footer (kept minimal + ATS-safe)
    # (do NOT dump the full JD into the resume PDF)
    story.append(Spacer(1, 10))
    story.append(Paragraph("Generated by ResumeMatch v2", small))

    doc.build(story)
    return buf.getvalue()


@router.post("/pdf")
def resume_pdf(req: ResumePdfRequest):
    pdf_bytes = _build_pdf(req)
    return StreamingResponse(
        BytesIO(pdf_bytes),
        media_type="application/pdf",
        headers={"Content-Disposition": 'inline; filename="ResumeMatch.pdf"'},
    )
